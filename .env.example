# QuantBox 환경변수 설정 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채워주세요:
#   cp .env.example .env

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔑 API Keys & Secrets (모든 인증 정보를 여기에 모아둠)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 바이낸스 API (필수 — 미설정 시 실행 불가)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false

# Discord Webhook (단방향: 알림 전송)
# DISCORD_WEBHOOK_URL=

# Discord Bot (양방향: 원격 명령)
# https://discord.com/developers/applications 에서 Bot 생성 후 토큰 입력
# DISCORD_BOT_TOKEN=             # Bot 토큰 (미설정 시 봇 비활성화)
# DISCORD_CHANNEL_ID=            # 명령 수신 채널 ID (숫자)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 레버리지 및 포지션 사이징
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LEVERAGE=2                     # Fallback 레버리지 (동적 레버리지 미사용 시)
TARGET_R_PCT=0.02              # 트레이드당 목표 리스크 (밸런스의 2%)
MAX_LEVERAGE=125               # 동적 레버리지 안전 상한 (바이난스 심볼별 한도가 실제 cap)
MAX_TRADERS=10                 # 최대 동시 트레이더 수
POSITION_SIZE_PCT=-1           # 슬롯당 자본 비율 (-1=자동: 1/MAX_TRADERS)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 전략 파라미터
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ENTRY_ZSCORE=2.0               # 진입 z-score 임계값
EXIT_ZSCORE=0.5                # 청산 z-score 임계값 (dynamic_exit 비활성 시)
STOP_LOSS_ZSCORE=1.5           # 손절 z-score (entry에서 +1.5 이동 시 손절)

# 최대 홀딩 시간 (이 시간 초과 시 강제 청산)
MAX_HOLDING_HOURS=20             # 20시간 (백테스트 80bars@15m과 동일)

# Formation window: 페어 선별에 사용할 과거 데이터 길이
FORMATION_HOURS=60               # 60시간 (15분봉 기준 240 bars)

# Dynamic Exit: half-life 기반 청산 임계값 자동 조정
USE_DYNAMIC_EXIT=true          # 활성화 시 EXIT_ZSCORE 대신 half-life 기반 동적 값 사용
DYNAMIC_EXIT_BASE=0.1          # 빠른 페어 exit z-score (half_life=min)
DYNAMIC_EXIT_RANGE=0.9         # 느린 페어까지의 범위 (max exit = base + range = 1.0)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Regime Protection
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Z_SCORE_CAP=4.0                # |z| > cap 이면 진입 거부 (레짐 변화 방어)
VOL_EXPANSION_GATE=2.0         # recent_std / formation_std > gate 이면 진입 거부

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Trailing Stop (ratchet stop)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TRAILING_STOP_ENABLED=true     # 트레일링 스톱 활성화 (z가 개선됐다 역전 시 청산)
TRAILING_STOP_ACTIVATE_DELTA=0.3  # entry 대비 Δz 이 이상 개선 시 활성화
TRAILING_STOP_BUFFER=0.1       # entry_z ± buffer에서 발동 (0이면 정확히 entry에서)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BTC Crash Gate (매크로 방어)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
BTC_CRASH_GATE_ENABLED=true    # BTC 급락/급등 시 진입 차단 활성화
BTC_CRASH_WINDOW=8             # 최근 N봉 체크 (15분봉 기준 = 2시간)
BTC_CRASH_THRESHOLD=0.03       # |수익률| > 3% 이면 진입 차단

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 드로다운 & 일일 손실 제한
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MAX_DRAWDOWN_PCT=0.10          # 세션 HWM 대비 10% 드로다운 시 전체 청산+정지
DAILY_LOSS_LIMIT_PCT=0.05      # 당일 시작 잔고 대비 5% 손실 시 진입 중단

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 비용 모델
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TRADING_FEE=0.0005             # 거래 수수료 (0.05%)
SLIPPAGE=0.001                 # 슬리피지 (0.10%)
FUNDING_RATE_8H=0.0001         # 8시간 펀딩비 (0.01%)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 유니버스 & 페이퍼 트레이딩
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
N_COINS=50                     # 상위 N개 코인 사용
PAPER_BALANCE=1000             # 페이퍼 트레이딩 시 가상 잔고 ($)
