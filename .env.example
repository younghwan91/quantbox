# QuantBox 환경변수 설정 템플릿  (v2.0 — Rubber Band Scalper)
# 이 파일을 .env로 복사한 뒤 값을 채워주세요:
#   cp .env.example .env

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔑 API Keys (필수 — 미설정 시 실행 불가)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false

# Discord Webhook (단방향: 알림 전송)
# DISCORD_WEBHOOK_URL=

# Discord Bot (양방향: 원격 명령)
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Rubber Band Scalper 파라미터
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LEVERAGE=2                     # 기본 레버리지
MAX_TRADERS=10                 # 최대 동시 포지션 수
POSITION_SIZE_PCT=-1           # 슬롯당 자본 비율 (-1=자동: 1/MAX_TRADERS)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Rubber Band Signal Parameters
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RB_LOOKBACK=8                  # 시그널 측정 봉 수 (15분봉 8개 = 2시간) — SACRED
RB_THRESHOLD=0.032             # v10.0: 최소 변동폭 (3.2%, +162% ret vs 4.5%)
RB_TARGET_RETRACE=1.5            # v12.4 HybTight: 1.5× retrace TP1 (AB-test winner)
RB_STOP_MULT=0.382               # v12.3 T100_S38_PBT: Fib 0.382 stop
RB_MAX_HOLD=25                 # v12.4 HybTight: 25 bars patience (was 20)
RB_STOP_DECAY=0.0              # 스탑 축소 비활성화 (장기 안정성)

# Multi-timeframe Confirmation (MTF — 비활성화: 장기 성능 저하)
RB_HTF_PERIOD=0                # HTF 트렌드 SMA 기간 (0 = 비활성화)
RB_HTF_BLOCK_THRESHOLD=0.01    # HTF 트렌드가 1% 이상 반대 방향이면 진입 차단
RB_HTF_AGREE_DISCOUNT=0.85     # HTF 동의 시 임계값 15% 완화
RB_HTF_AGREE_STOP_MULT=0.95    # HTF 동의 시 스탑 5% 축소

# Dynamic Leverage (v4.4: flat 1.5x, A/B validated)
RB_DYNAMIC_LEVERAGE_ENABLED=true  # 레버리지 파이프라인 활성화
RB_BASE_LEVERAGE=1.5              # 전 트레이드 1.5x 고정 (최적 sweet spot)
RB_LEVERAGE_SCALE=0.0             # 컨피던스 스케일링 비활성화 (고정 레버리지)
RB_MAX_LEVERAGE=20                # MTF 곱셈 후 최종 안전 상한 (하드캡)

# BTC Directional Alignment (v4.2, A/B validated)
# ── Regime-Switch + Confidence Scoring (v6.0) ──
RB_ENTRY_MODE=confidence           # Entry mode: 'confidence' | 'regime_switch' | 'btc_directional' | 'raw'
RB_BTC_REGIME_PERIOD=96            # BTC SMA period for regime detection (96봉 = 24시간)
RB_ASSET_TREND_PERIOD=192          # Asset SMA period for classic pullback (192봉 = 48시간)

# ── Confidence Scoring (v12.3 M-2SSTSX) ──
RB_MIN_CONFIDENCE=3                # v12.3: 최소 3 (M-2SSTSX)
RB_CONFIDENCE_LEVERAGE_STEP=0.0    # 컨피던스당 추가 레버리지 (0=고정, 1.0=moderate)
RB_RSI_PERIOD=14                   # RSI 계산 기간
RB_VOL_PERIOD=20                   # 거래량 SMA 기간 (스파이크 감지)

# ── v7.0 Multi-Timeframe Confirmation (365-day A/B validated) ──
# 4h 캔들 데이터로 15m 진입을 확인. MDD 16.5% → 4.3% (-74%), Calmar 8.65 → 32.42
RB_MTF_CONFIRMATION_ENABLED=true   # 4h 트렌드 확인 활성화
RB_MTF_SMA_PERIOD=12               # 4h SMA 기간 (12봉 = 2일)
RB_MTF_LEVERAGE_MULT=2.5           # v10.1: MTF 확인 후 레버리지 배수 (2.0→2.5, +35% ret)

# ── v8.0 Dynamic Target (DISABLED in v9.0 — Fib discipline outperforms) ──
# 피보나치 0.382 고정 목표가 동적 스케일링보다 우수. 타이트한 스탑(0.786)에 빠른 TP 필요.
RB_DYNAMIC_TARGET_ENABLED=false    # 비활성화: Fib 0.382 고정 > 동적 스케일링
RB_TARGET_CONF3=0.45               # confidence=3 목표 (사용 안 함)
RB_TARGET_CONF4=0.50               # confidence=4 목표 (사용 안 함)
RB_TARGET_CONF5=0.55               # confidence≥5 목표 (사용 안 함)

# ── v9.0 S+R+M Confluence Pipeline (A/B validated, Calmar +33.6%) ──
# MACD 히스토그램 반전 + 스토캐스틱 %K/%D 크로스 = 추가 컨피던스 증거
# v9.0 S+R+M Confluence (v12.6: both disabled — R21 shows Stoch/MACD = noise)
RB_MACD_ENABLED=false              # v12.6: DISABLED (R21: WR +11pp without MACD)
RB_MACD_FAST=12                    # MACD fast EMA 기간
RB_MACD_SLOW=26                    # MACD slow EMA 기간
RB_MACD_SIGNAL_PERIOD=14           # MACD signal EMA 기간 (14=최적)
RB_STOCH_ENABLED=false             # v12.6: DISABLED (R21: WR +11pp without Stoch)
RB_STOCH_K_PERIOD=3                # v10.0: 더 빠른 스토캐스틱 (+5% Calmar vs 5)
RB_STOCH_D_PERIOD=3                # 스토캐스틱 %D 기간
# v12.6 Climax Volume Filter (R21 champion [E]: Calmar 728→1171)
RB_CLIMAX_ENABLED=true             # 극단 거래량 스파이크 컨피던스 증거
RB_CLIMAX_VOL_MULT=3.0             # vol > 3.0×vol_SMA(20) = climax 정의 (R21 best)
# v12.6 ATR-Based Stop (R21: WR 62.2%, DD 5.8%, replaces fixed 0.382×move)
RB_ATR_STOP_ENABLED=true           # ATR 기반 동적 손절 활성화
RB_ATR_STOP_MULT=2.0               # SL = 2.0×ATR% (R21 최적)
RB_ATR_STOP_FLOOR=0.005            # SL 최소 0.5% (노이즈 SL 방지)
RB_ATR_STOP_CAP=0.04               # SL 최대 4.0% (리스크 제한)

# ── v11.4 Adaptive Threshold (Walk-Forward Validated) ──
# Per-bar threshold = clip(ATR_MULTIPLIER × ATR%(ATR_PERIOD), FLOOR, CAP)
# Chosen config: 2.5x_f1 — OOS Sharpe 8.23, OOS/IS 1.09, zero overfitting
RB_ATR_PERIOD=48                   # ATR EMA 기간 (48 × 15분 = 12시간)
RB_ATR_MULTIPLIER=2.0              # v12.2: ATR 배수 (2.5→2.0, E-3Slot A/B validated)
RB_THRESHOLD_FLOOR=0.008           # v12.2: 최소 임계값 (0.8%)
RB_THRESHOLD_CAP=0.06              # 최대 임계값 (6%)

# ── v7.0 Independent 4H Rubber Band ──
# 4h 타임프레임에서 독립적으로 평균회귀 트레이딩
# 4h-only: Ret +52.2%, DD 4.8%, Calmar 10.87
RB_HTF_INDEPENDENT_ENABLED=false   # v10.2: Disabled (dead code in production)
RB_HTF_RB_LOOKBACK=3               # 4h lookback (12시간)
RB_HTF_RB_THRESHOLD=0.10           # 10% 임계값
RB_HTF_RB_TARGET_RETRACE=0.5       # 50% 되돌림 목표
RB_HTF_RB_STOP_MULT=0.8            # 0.8x 손절
RB_HTF_RB_MAX_HOLD=12              # 12봉 (2일)
RB_HTF_RB_BTC_SMA_PERIOD=48        # BTC SMA (8일)

RB_BTC_DIRECTIONAL_ENABLED=true   # BTC 방향 정렬: Long→BTC하락, Short→BTC상승 시만 진입
RB_BTC_DIRECTIONAL_PERIOD=48      # v11.0: 12h BTC momentum (A/B validated)

# v12.3 PBT Exit Mode (R7/R8 champion)
RB_PARTIAL_EXIT_ENABLED=true      # PBT mode: 50% partial → BE → ATR trail
RB_PARTIAL_EXIT_FRACTION=0.5      # 부분 청산 비율 (0.5 = 50%)
RB_TRAIL_ATR_MULT=1.0             # v12.4 HybTight: 1.0×ATR tighter trail (was 1.5)
RB_BREAKEVEN_AFTER_PARTIAL=true   # Move stop to breakeven after TP1
RB_RUNNER_MAX_HOLD_MULT=3.0       # v12.4 HybTight: runner max_hold = 3× max_hold

# v12.3.3: Pre-TP1 trailing parameters (configurable, R5 A/B defaults)
RB_PRE_TP1_TRAIL_ACTIVATION=0.5   # Trail after 50% of target reached
RB_PRE_TP1_TRAIL_FACTOR=0.3       # Exit at 30% of best PnL

# R:R-Gated Leverage (v4.3, A/B validated)
RB_RR_LEVERAGE_ENABLED=true       # R:R 기준 레버리지 게이트: 손익비 높을 때만 레버리지
RB_MIN_RR_FOR_LEVERAGE=0.30       # 레버리지 허용 최소 R:R 비율

# ── v12.1 Symbol Whitelist & Dynamic Capital (B-50 winner: 50 symbols) ──
RB_SYMBOL_WHITELIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,XLMUSDT,DOTUSDT,1000PEPEUSDT,ARBUSDT,FETUSDT,1000SHIBUSDT,OPUSDT,ATOMUSDT,HBARUSDT,ICPUSDT,FILUSDT,TRXUSDT,SUIUSDT,TONUSDT,LTCUSDT,BCHUSDT,UNIUSDT,NEARUSDT,APTUSDT,AAVEUSDT,INJUSDT,ETCUSDT,GRTUSDT,STXUSDT,EGLDUSDT,AXSUSDT,SANDUSDT,THETAUSDT,ALGOUSDT,RUNEUSDT,DYDXUSDT,CRVUSDT,LDOUSDT,COMPUSDT,SNXUSDT,VETUSDT,APEUSDT,ENAUSDT,TAOUSDT,WLDUSDT,WIFUSDT
RB_MAX_CONCURRENT=2                # v12.3: M-2SSTSX (2 slots)
RB_DYNAMIC_CAPITAL_ENABLED=true    # 동적 자본 배분: balance / max(1, n_active+1)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# v12.3 Safety Features (M-2SSTSX)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SteepX Confidence Sizing
RB_STEEP_CAP_CURVE=true
RB_CAP_MULT_CONF2=0.3
RB_CAP_MULT_CONF3=0.5
RB_CAP_MULT_CONF4=1.5
RB_CAP_MULT_CONF5=2.0
# SoftTight DD Scaling
RB_SOFT_EQUITY_SCALE=true
RB_SOFT_EQ_DD1=0.02
RB_SOFT_EQ_SCALE1=0.80
RB_SOFT_EQ_DD2=0.04
RB_SOFT_EQ_SCALE2=0.60
RB_SOFT_EQ_DD3=0.06
RB_SOFT_EQ_SCALE3=0.40
# Vol-Adjusted Sizing
RB_VOL_ADJUSTED_SIZE=true
RB_VOL_ADJ_MEDIAN_ATR=0.01
RB_VOL_ADJ_MIN=0.4
RB_VOL_ADJ_MAX=2.0
# Direction Diversity
RB_DIR_DIVERSITY_ENABLED=true
RB_MAX_SAME_DIRECTION=2

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 리스크 관리
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MAX_DRAWDOWN_PCT=0.10          # 세션 HWM 대비 10% 드로다운 시 전체 청산+정지

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VolStraddle Strategy (R39-VR856 — VR compression multi-TF)
# --strategy vol_straddle 로 실행 시 사용
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VR Computation
VS_VR_SHORT=8                      # Short ATR period for VR (R39: was 7)
VS_VR_LONG=56                      # Long ATR period for VR (R39: was 50)

# D_mom8: Directional entry on VR compression
VS_D_VR_THRESHOLD=0.50             # A1-D50: VR < 0.50 → entry (was 0.45)
VS_D_SL=0.01                       # 1% stop loss
VS_D_TP=0.12                       # 12% hard TP ceiling (R43: was 5%)
VS_D_TRAIL_ACTIVATE=0.02           # R43: trailing stop after +2% gain
VS_D_TRAIL_DISTANCE=0.003          # R43: trail 0.3% behind peak
VS_MOMENTUM_PERIOD=8               # Momentum(8) for direction

# S_d8: Straddle mode (Phase 2 — requires Binance Hedge Mode)
VS_S_VR_THRESHOLD=0.55             # S VR entry threshold
VS_S_SQUEEZE_DUR=4                 # Min squeeze duration (R39: was 8)
VS_S_SL=0.015                      # 1.5% SL per straddle leg
VS_S_TP=0.05                       # 5% TP per straddle leg
VS_STRADDLE_ENABLED=true           # S_d8 straddle enabled
VS_HEDGE_MODE=true                 # Binance Hedge Mode (dualSidePosition)

# Max Hold (bars at each TF, ≈ 48h real-time)
VS_MAX_HOLD_15M=192                # 192 × 15m = 48h
VS_MAX_HOLD_1H=48                  # 48 × 1h = 48h
VS_MAX_HOLD_4H=12                  # 12 × 4h = 48h

# Multi-TF Control
VS_ENABLE_15M=true
VS_ENABLE_1H=true
VS_ENABLE_4H=true

# Position Sizing
VS_BASE_LEVERAGE=25.0              # v13.0: 25x aggressive (L/N=2.5, Calmar 10.12)
VS_MAX_LEVERAGE=25                  # Hard cap (matches base_leverage)
VS_MAX_CONCURRENT=10                # v13.0: 10 slots (L/N=25/10=2.5)

# CW-Tier Conviction Sizing (R34 validated)
# Score = count of 4 conditions (E2,C2,B3,A3), 0-4
# Multiplier: 0→0.5x, 1→1.0x, 2→1.5x, 3→2.0x, 4→2.5x
VS_CW_ENABLED=true                 # Enable conviction-weighted sizing
VS_MIN_CONVICTION_SCORE=0          # Min score to enter (0=all, 3=T3-Triple)
VS_E2_SMA_PERIOD=20                # E2: SMA lookback for mean proximity
VS_E2_THRESHOLD=0.005              # E2: 0.5% max distance from SMA
VS_C2_BTC_MOM_THRESHOLD=0.01       # C2: 1% max BTC momentum magnitude
VS_A3_DEEP_VR_THRESHOLD=0.35       # A3: D deep compression threshold
VS_A3_LONG_SQUEEZE_DUR=16          # A3: S extended squeeze duration

# Symbol Whitelist (empty = use RB_SYMBOL_WHITELIST)
# VS_SYMBOL_WHITELIST=

# MA Cluster Squeeze (R44d V17, 4h-only complementary strategy)
# 4 SMAs (20/50/100/200) converge → breakout + momentum direction
# 93.7% non-overlapping with VR squeeze.
VS_MA_CLUSTER_ENABLED=true         # Enable MA cluster signals
VS_MA_CLUSTER_PCT=0.03             # Max spread among 4 SMAs (3%)
VS_MA_CLUSTER_MIN_DURATION=8       # Min 4h bars in cluster (≈32h)
VS_MA_CLUSTER_SL=0.02              # 2% stop loss
VS_MA_CLUSTER_TP=0.08              # 8% take profit
VS_MA_CLUSTER_MAX_HOLD_4H=12       # 12 × 4h = 48h
VS_MA_CLUSTER_LEVERAGE=12.0        # Risk parity: 12x × 2% ≈ 25x × 1%

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 비용 모델
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TRADING_FEE=0.0005             # 거래 수수료 (0.05%)
SLIPPAGE=0.001                 # 슬리피지 (0.10%)
FUNDING_RATE_8H=0.0001         # 8시간 펀딩비 (0.01%)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 유니버스 & 페이퍼 트레이딩
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
N_COINS=50                     # 상위 N개 코인 스캔
PAPER_BALANCE=1000             # 페이퍼 트레이딩 시 가상 잔고 ($)
