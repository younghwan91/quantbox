# QuantBox 환경변수 설정 템플릿  (v2.0 — Rubber Band Scalper)
# 이 파일을 .env로 복사한 뒤 값을 채워주세요:
#   cp .env.example .env

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔑 API Keys (필수 — 미설정 시 실행 불가)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false

# Discord Webhook (단방향: 알림 전송)
# DISCORD_WEBHOOK_URL=

# Discord Bot (양방향: 원격 명령)
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Rubber Band Scalper 파라미터
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LEVERAGE=2                     # 기본 레버리지
MAX_TRADERS=10                 # 최대 동시 포지션 수
POSITION_SIZE_PCT=-1           # 슬롯당 자본 비율 (-1=자동: 1/MAX_TRADERS)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 리스크 관리
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MAX_DRAWDOWN_PCT=0.10          # 세션 HWM 대비 10% 드로다운 시 전체 청산+정지
DAILY_LOSS_LIMIT_PCT=0.05      # 당일 시작 잔고 대비 5% 손실 시 진입 중단

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 비용 모델
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TRADING_FEE=0.0005             # 거래 수수료 (0.05%)
SLIPPAGE=0.001                 # 슬리피지 (0.10%)
FUNDING_RATE_8H=0.0001         # 8시간 펀딩비 (0.01%)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 유니버스 & 페이퍼 트레이딩
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
N_COINS=30                     # 상위 N개 코인 스캔
PAPER_BALANCE=1000             # 페이퍼 트레이딩 시 가상 잔고 ($)
