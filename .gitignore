# ── Python cache & compiled artifacts ──
__pycache__/
*.pyc
*.pyo
*.nbc
*.nbi

# ── Numba AOT cache ──
numba_cache/

# ── Virtual environment ──
.venv/

# ── Test/IDE caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Data (downloaded locally, not committed) ──
/data/*
!/data/.gitkeep

# ── Logs (runtime output) ──
logs/
*.log

# ── Secrets & Environment ──
.env
.env.*
!.env.example
*.env
.secrets
*.pem
*.key
config.local.json
secrets.json

# ── Misc local-only dirs ──
/training_data/
/saved_plots/
/reports/
/temp/
devlog/.coverage

# ── 커버리지 산출물 ──
# 루트 .coverage가 추적돼 있었다 — 테스트를 돌릴 때마다 바뀌어서 워킹트리가 항상
# 더럽고, 공개 트리 게이트(scripts/make_public_tree.sh)가 상시 거부됐다.
.coverage
.coverage.*
htmlcov/
.hypothesis/

# OMC runtime state
.omc/
