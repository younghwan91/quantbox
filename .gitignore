# ── Python cache & compiled artifacts ──
__pycache__/
*.pyc
*.pyo
*.nbc
*.nbi

# ── Numba AOT cache ──
numba_cache/

# ── Virtual environment ──
.venv/

# ── Test/IDE caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Data (downloaded locally, not committed) ──
/data/*
!/data/.gitkeep

# ── Logs (runtime output) ──
logs/
*.log

# ── Secrets & Environment ──
.env
.env.*
!.env.example
*.env
.secrets
*.pem
*.key
config.local.json
secrets.json

# ── Misc local-only dirs ──
/training_data/
/saved_plots/
/reports/
/temp/
devlog/.coverage
