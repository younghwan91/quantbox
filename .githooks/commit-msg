#!/usr/bin/env bash
# .githooks/commit-msg
# Detects fix/hotfix/incident commits and warns if skill files weren't updated.
# Install: git config core.hooksPath .githooks

COMMIT_MSG=$(cat "$1")
SKILLS_DIR=".github/instructions"

# Only trigger for bug fix commits
if ! echo "$COMMIT_MSG" | grep -qiE "^(fix|hotfix|bug)\(|^(fix|hotfix):|incident #"; then
    exit 0
fi

# Check if any .instructions.md was staged
STAGED_SKILLS=$(git diff --cached --name-only 2>/dev/null | grep "\.instructions\.md$")

if [ -z "$STAGED_SKILLS" ]; then
    echo ""
    echo "⚠️  SKILLS UPDATE REMINDER"
    echo "   Fix commit detected: $(echo "$COMMIT_MSG" | head -1)"
    echo ""
    echo "   No .instructions.md files were updated in this commit."
    echo "   Did you add this incident to the relevant skill file?"
    echo ""
    echo "   Quick check: python scripts/check_skills.py --post-fix"
    echo ""
    echo "   → If this is a new bug pattern, update:"
    echo "     .github/instructions/debugging.instructions.md"
    echo "     .github/copilot-instructions.md (incident table)"
    echo ""
    echo "   (Commit will proceed — update skills in a follow-up commit if needed)"
    echo ""
else
    echo ""
    echo "✓ Skills updated: $STAGED_SKILLS"
    echo ""
fi

exit 0
