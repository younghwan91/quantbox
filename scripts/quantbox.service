[Unit]
Description=QuantBox Vol Straddle Live Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=young
WorkingDirectory=/home/user/Documents/git/quantbox
EnvironmentFile=/home/user/.env.quantbox
Environment="PATH=/home/user/Documents/git/quantbox/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/user/Documents/git/quantbox/.venv/bin/python3 -m quantbox.scalper --strategy vol_straddle

# Watchdog: systemd kills if no ping in 20 min (15m bar wait = ~900s + 300s margin)
WatchdogSec=1200

# Auto-restart on crash with rate limiting
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=300

# Log to journald
StandardOutput=journal
StandardError=journal

# Allow enough time to save state on shutdown
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
